#/bin/bash

METABASE_HOME=$(realpath .)
if [ ! -d "$METABASE_HOME" ]; then
  echo "Can not find metabase home"
  exit 0
fi

cd $METABASE_HOME

export MB_JETTY_PORT=3000
export MB_DB_TYPE=mysql
export MB_DB_DBNAME=metabase
export MB_DB_PORT=3306
export MB_DB_USER=vincent
export MB_DB_PASS=ViVopu__zpoooiq@vincent
export MB_DB_HOST=localhost

echo $METABASE_HOME
LOGOUT=logs/metabase-vincent-`date +%Y%m%d`.out
mkdir -p logs

java -jar "$METABASE_HOME/metabase.jar" >> "$LOGOUT" 2>&1 &
